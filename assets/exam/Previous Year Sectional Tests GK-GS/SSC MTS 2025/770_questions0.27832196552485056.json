ption_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_link_2":"","image_link_3":"","answer":"2","solution_heading":"Full Solution","solution_text":" <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option B - Navratna.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:10pt\"><span> </span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Bharat Electronics Limited (BEL), a defence public sector undertaking under the Ministry of Defence, was conferred the 'Navratna' status by the Government of India, reflecting its strong financial performance and operational efficiency, placing it a tier above Miniratna companies but below the elite Maharatna category.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""},{"id":"29637","test_series_id":"2","test_id":"770","question_type":"1","question_ui_type":"1","question":" <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span style=\"font-weight:bold\">Which book, a collection of 103 poems selected from Bengali poetry, was authored by Rabindranath Tagore?</span></p>","option_1":"Gitanjali","option_2":"Urvasi","option_3":"Aansoo","option_4":"Kamayni","option_5":"","option_6":"","option_7":"","option_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_link_2":"","image_link_3":"","answer":"1","solution_heading":"Full Solution","solution_text":" <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option A - Gitanjali.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:10pt\"><span> </span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Gitanjali ('Song Offerings'), for which Rabindranath Tagore won the Nobel Prize in Literature in 1913, is an English rendering containing 103 poems selected and translated by Tagore himself from his original Bengali works. Urvasi is a poem by Ramdhari Singh Dinkar, Aansoo by Jaishankar Prasad, and Kamayni also by Jaishankar Prasad — none of these are Tagore's works.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""},{"id":"29638","test_series_id":"2","test_id":"770","question_type":"1","question_ui_type":"1","question":" <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span style=\"font-weight:bold\">The term \"Deep Extra Cover\", \"3rd Man\" and \"Fine leg\" are related to which of the following sports?</span></p>","option_1":"Baseball","option_2":"Basketball","option_3":"Football","option_4":"Cricket","option_5":"","option_6":"","option_7":"","option_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_link_2":"","image_link_3":"","answer":"4","solution_heading":"Full Solution","solution_text":" <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option D - Cricket.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:10pt\"><span> </span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>'Deep Extra Cover', 'Third Man', and 'Fine Leg' are standard fielding position names used in the sport of Cricket, describing specific locations on the field relative to the batsman. These terms have no equivalent usage in baseball, basketball, or football.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""},{"id":"29639","test_series_id":"2","test_id":"770","question_type":"1","question_ui_type":"1","question":" <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span style=\"font-weight:bold\">The Motihari-Amlekhgunj petroleum pipeline project is associated with India and ______.</span></p>","option_1":"Bhutan","option_2":"Nepal","option_3":"Sri Lanka","option_4":"Bangladesh","option_5":"","option_6":"","option_7":"","option_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_link_2":"","image_link_3":"","answer":"2","solution_heading":"Full Solution","solution_text":" <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option B - Nepal.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:10pt\"><span> </span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>The Motihari-Amlekhgunj Petroleum Products Pipeline is South Asia's 