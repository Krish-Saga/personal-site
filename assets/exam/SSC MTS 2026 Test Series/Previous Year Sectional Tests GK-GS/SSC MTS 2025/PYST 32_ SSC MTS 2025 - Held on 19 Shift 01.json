_6":"","option_7":"","option_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_link_2":"","image_link_3":"","answer":"1","solution_heading":"Full Solution","solution_text":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option A - 2015.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>The Digital India programme was launched by the Government of India on 1 July 2015 with the aim of transforming India into a digitally empowered society and knowledge economy.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""},{"id":"31192","test_series_id":"2","test_id":"836","question_type":"1","question_ui_type":"1","question":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>The National Green Hydrogen Mission in India aims to achieve a targeted production capacity of 5 million tonnes per annum green hydrogen by _____.</span></p>","option_1":"2027","option_2":"2030","option_3":"2035","option_4":"2047","option_5":"","option_6":"","option_7":"","option_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_link_2":"","image_link_3":"","answer":"2","solution_heading":"Full Solution","solution_text":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option B - 2030.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>The National Green Hydrogen Mission, approved in January 2023, targets a green hydrogen production capacity of at least 5 million tonnes per annum by the year 2030.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""},{"id":"31193","test_series_id":"2","test_id":"836","question_type":"1","question_ui_type":"1","question":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Which Mughal emperor built Akbar's Mausoleum at Sikandra?</span></p>","option_1":"Jahangir","option_2":"Humayun","option_3":"Shahjahan","option_4":"Aurangzeb","option_5":"","option_6":"","option_7":"","option_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_link_2":"","image_link_3":"","answer":"1","solution_heading":"Full Solution","solution_text":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option A - Jahangir.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Akbar's tomb at Sikandra, near Agra, was begun during Akbar's own lifetime and completed by his son and successor, Emperor Jahangir, in 1613.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""},{"id":"31194","test_series_id":"2","test_id":"836","question_type":"1","question_ui_type":"1","question":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Which of the following is a biotic stress for crops?</span></p>","option_1":"Drought","option_2":"Salinity","option_3":"Cold","option_4":"Insects","option_5":"","option_6":"","option_7":"","option_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_link_2":"","image_link_3":"","answer":"4","solution_heading":"Full Solution","solution_text":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option D - Insects.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Biotic stress is caused by living organisms such as insects, pathogens, and weeds that harm crops. Drought, salinity, and cold are abiotic (non-living, environmental) stresses.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""},{"id":"31195","test_series_id":"2","test_id":"836","question_type":"1","question_ui_type":"1","question":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Which of the following is a Ghan Vadya?</span></p>","option_1":"Das-kathi","option_2":"Naal","option_3":"Jantar","option_4":"Magudi","option_5":"","option_6":"","option_7":"","option_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_link_2":"","image_link_3":"","answer":"1","solution_heading":"Full Solution","solution_text":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option A - Das-kathi.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Ghan Vadya refers to idiophone instruments that produce sound by being struck, without the use of strings, membranes, or air columns. Das-kathi, a wooden clapper instrument used in Indian folk music, falls in this category, while Naal (membranophone), Jantar (chordophone), and Magudi (aerophone) belong to other classifications.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""}]