rd;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option B - 1994.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Aishwarya Rai won the Miss World title in 1994, representing India. This was a landmark year for India in international beauty pageants, as Sushmita Sen won the Miss Universe title the same year, marking India's dual global pageant triumph.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""}]