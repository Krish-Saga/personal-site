_3":"CNES","option_4":"JAXA","option_5":"","option_6":"","option_7":"","option_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_link_2":"","image_link_3":"","answer":"2","solution_heading":"Full Solution","solution_text":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>Correct Answer: Option B - NASA.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>The Hubble Space Telescope, operated by NASA (in collaboration with ESA), captured images of the galaxy LEDA 1313424, nicknamed the 'Bullseye Galaxy', which has nine visible concentric rings — the most ever observed in a single galaxy.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""},{"id":"29837","test_series_id":"2","test_id":"778","question_type":"1","question_ui_type":"1","question":"<style> *{overflow-wrap: break-word;} </style> <p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><span>The principal mineral-bearing belts in _______ are Vidarbha area and Konkan area.</span></p>","option_1":"Maharashtra","option_2":"Goa","option_3":"Madhya Pradesh","option_4":"Gujarat","option_5":"","option_6":"","option_7":"","option_8":"","option_9":"","option_10":"","option_image_1":"","option_image_2":"","option_image_3":"","option_image_4":"","option_image_5":"","option_image_6":"","option_image_7":"","option_image_8":"","option_image_9":"","option_image_10":"","image_link_1":"","image_