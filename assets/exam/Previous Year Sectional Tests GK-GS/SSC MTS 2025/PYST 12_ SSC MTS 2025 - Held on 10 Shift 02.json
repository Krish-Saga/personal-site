gin-top:0pt;margin-bottom:0pt;font-size:10pt\"><span>Correct Answer: Option B - Tabla.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:10pt\"><span>Ustad Zakir Hussain was a globally celebrated tabla virtuoso, son of the legendary tabla maestro Ustad Alla Rakha, and is credited with popularising Indian classical percussion music on the world stage.</span></p>","solution_image_1":"","solution_image_2":"","solution_video":"","difficulty_level":"0","topic":"","exam":"","section_id":"4","subject":"","concept":"","report_count":"0","set_no":"0","positive_marks":"3.00","negative_marks":"1.00","sortingparam":"0.00","question_heading":"","directive":"","deleted":"0","image_check":"0","subject_title":"","concept_title":"","topic_title":""}]